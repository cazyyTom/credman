# Copy to .env (repo root) and replace every "change-me". Never commit .env.
# Generate a strong password with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Password docker compose gives the local Postgres container's "credman" user.
POSTGRES_PASSWORD=change-me

# Connection string for the backend and seed.py; its password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://credman:change-me@localhost:5432/credman

# Optional: comma-separated origins allowed by CORS (default: http://localhost:3000).
# CORS_ORIGINS=http://localhost:3000

# Optional: connection pool bounds (defaults: 1 and 10).
# POOL_MIN=1
# POOL_MAX=10
